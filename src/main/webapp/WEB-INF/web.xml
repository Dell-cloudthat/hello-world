<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
>
	<!-- This is only here because Maven requires it to make a war. -->

	<servlet>
		<servlet-name>alertSnapshot</servlet-name>
		<servlet-class>com.efsavage.alerts.AlertSnapshotServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>alertSnapshot</servlet-name>
		<url-pattern>/api/alert-snapshot</url-pattern>
	</servlet-mapping>
</web-app>